<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion><UseWindowsForms>true</UseWindowsForms><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>../../assets/HearthLink.ico</ApplicationIcon><AssemblyName>HearthLink</AssemblyName><Version>0.4.1</Version></PropertyGroup><ItemGroup><ProjectReference Include="../HearthLink.Core/HearthLink.Core.csproj" /><EmbeddedResource Include="../../assets/HearthLink.ico" LogicalName="HearthLink.AppIcon.ico" /></ItemGroup>
<!-- The .NET runtime stays pinned to 10.0.13 (bundled notices match it). A RuntimeFrameworkVersion property would also pin the Windows SDK projection used for Windows Hello, so only the two runtime frameworks get the version. -->
<Target Name="PinRuntimeFrameworks" BeforeTargets="ProcessFrameworkReferences"><ItemGroup><FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App" RuntimeFrameworkVersion="10.0.13" /></ItemGroup></Target></Project>
